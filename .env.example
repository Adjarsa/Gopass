# Copiez ces noms dans les variables du service Railway. Ne mettez jamais de vraie valeur dans le dépôt.

# Base de données : sur Railway, référencez la variable DATABASE_URL du service PostgreSQL.
DATABASE_URL=
# Clé de signature des sessions : une longue chaîne aléatoire (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=
# Adresse publique du site, sans barre finale. Exemple : https://www.votre-domaine.dz
PUBLIC_URL=

# Compte administrateur créé au premier démarrage.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chargily Pay. Sans clé, le paiement en ligne est désactivé et le site propose les espèces.
CHARGILY_SECRET_KEY=
# Mode test par défaut. En production, mettez l'adresse « live » indiquée par Chargily.
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2

# Règles commerciales (valeurs par défaut entre parenthèses).
CREDIT_VALUE_DZD=400
CANCEL_HOURS=12
PAYOUT_RATE=0.75
BOOKING_WINDOW_DAYS=7
PLAN_DURATION_DAYS=30

# E-mails (facultatif). Sans SMTP, aucun e-mail n'est envoyé.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Données d'exemple (facultatif) : SEED_DEMO=1 crée 6 studios fictifs au premier démarrage.
SEED_DEMO=
DEMO_PASSWORD=
